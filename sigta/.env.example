# Configuración de la Aplicación SIGTA
APP_NAME=SIGTA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://localhost:8000
APP_LOCALE=es

# Registro de Logs y Diagnóstico
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de Datos (SQLite local / MySQL 8.0 Staging y Producción - SIGTA §2.2, §3.2.2)
DB_CONNECTION=sqlite
DB_DATABASE=/ruta/absoluta/sigta/database/database.sqlite
# Configuración para MySQL 8.0:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sigta
# DB_USERNAME=sigta_app
# DB_PASSWORD=

# Drivers de Almacenamiento, Sesión, Caché y Colas (SIGTA §2.2, §3.2.2)
BROADCAST_DRIVER=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=60

# Algoritmo de Hashing de Contraseñas (SIGTA §2.5.2)
HASH_DRIVER=argon2id

# Configuración de Notificaciones y Correo SMTP (Canal Secundario - SIGTA §2.2, §3.2.2)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notificaciones@sigta.local"
MAIL_FROM_NAME=""
